# Copy this file to `.env`. The mobile app talks only to the shared
# inventory-api (supabase/api), never to the database directly.
#
# Base URL of the inventory-api (dev API -> dev Neon branch via Doppler `dev`):
#   Android emulator      -> http://10.0.2.2:<port>  (maps to the host's localhost)
#   iOS simulator/desktop -> http://localhost:<port> (run the API on that Mac)
#   Physical device / Mac reaching a Windows+WSL host:
#       -> http://<windows-lan-ip>:<port>  (needs a netsh portproxy on Windows)
#       -> or a tunnel URL (cloudflared/ngrok)
#   See docs/MOBILE_DEV_API.md for the full setup.
API_URL=http://10.0.2.2:4000
