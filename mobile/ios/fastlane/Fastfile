# Tagged-release lane for the inventory app's iOS build. Triggered by
# .forgejo/workflows/ios-release.yml on an `ios-v*` tag push, on the Mac mini
# runner (label `macos`).
#
# Adapted from ego-mobile/ios/fastlane/Fastfile, whose pipeline reached
# TestFlight by hand on 2026-09-04. The differences here: the Flutter project
# lives in `mobile/` (not the repo root), the backend URL is a plain
# --dart-define=API_URL (there is no env/*.json), and the build number is
# taken from TestFlight so it can never repeat.
#
# Flutter does the archive + export (`flutter build ipa`); fastlane fetches the
# signing credentials into a CI keychain first and uploads the .ipa afterwards.

require "shellwords"
require "fileutils"

default_platform(:ios)

# Absolute paths computed once, up front — fastlane's `sh` does not reliably keep
# a Dir.chdir between two calls (ego hit exactly that).
IOS_DIR = File.expand_path("..", File.dirname(__FILE__))
FLUTTER_ROOT = File.expand_path("..", IOS_DIR) # …/mobile
EXPORT_OPTIONS_PLIST = File.join(IOS_DIR, "ExportOptions.plist")
IPA_DIR = File.join(FLUTTER_ROOT, "build", "ios", "ipa")

BUNDLE_ID = "co.verlet.inventory"
TEAM_ID = ENV["FASTLANE_TEAM_ID"] || "4CK2QVP3CA"

# The API this build talks to. TestFlight is how the phone app is shipped, so
# the default is PRODUCTION. Override with the API_URL environment variable.
API_URL = ENV["API_URL"] && !ENV["API_URL"].strip.empty? ? ENV["API_URL"].strip : "https://api-production-4a46.up.railway.app"

platform :ios do
  desc "Build, sign and upload a TestFlight build"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
    )

    # A CI-only keychain, so this neither touches nor depends on the runner
    # user's login keychain.
    setup_ci

    # readonly: CI only fetches the existing certificate and profile; it never
    # creates them (creating burns Apple's limited distribution-certificate
    # quota). The profile for co.verlet.inventory is created ONCE with
    # `fastlane match appstore --readonly false` (see the plan doc, Part C) —
    # by hand on the Mac mini, or by ONE CI run with the repo variable
    # IOS_MATCH_READONLY set to "false" (then set it back). That one-off run
    # needs a git token that can WRITE to the match repo and an Admin API key.
    readonly = ENV["MATCH_READONLY"].to_s.strip.downcase != "false"
    UI.important("MATCH_READONLY=false: match may CREATE the provisioning profile (and push it to the match repo). Set IOS_MATCH_READONLY back to true after this run.") unless readonly
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: readonly,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_ci.keychain-db",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
    )

    # The checked-in project stays on Automatic signing for local development;
    # for this archive only, point it at the profile match just installed.
    # (Automatic signing on a runner with no Apple ID picks the wrong identity.)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(IOS_DIR, "Runner.xcodeproj"),
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"],
    )

    # Apple refuses a build number that was already uploaded. Ask TestFlight for
    # the latest and add one, unless the workflow supplied one.
    build_number = (ENV["IOS_BUILD_NUMBER"] || "").strip
    if build_number.empty?
      build_number = (latest_testflight_build_number(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        initial_build_number: 0,
      ) + 1).to_s
    end
    version = (ENV["IOS_VERSION"] || "").strip
    UI.message("Building #{version.empty? ? "(version from pubspec)" : version} (#{build_number}) against #{API_URL}")

    # `mobile/.env` is gitignored but is declared as a Flutter asset, so a fresh
    # checkout cannot build without it. The real URL comes from --dart-define,
    # which takes precedence over this file.
    env_file = File.join(FLUTTER_ROOT, ".env")
    example = File.join(FLUTTER_ROOT, ".env.example")
    FileUtils.cp(example, env_file) if !File.exist?(env_file) && File.exist?(example)

    name_flag = version.empty? ? "" : "--build-name=#{version.shellescape} "
    sh(
      "cd #{FLUTTER_ROOT.shellescape} && " \
      "flutter pub get && " \
      "flutter build ipa --release " \
      "--build-number=#{build_number.shellescape} " \
      "#{name_flag}" \
      "--dart-define=API_URL=#{API_URL.shellescape} " \
      "--export-options-plist=#{EXPORT_OPTIONS_PLIST.shellescape}"
    )

    # The .ipa is named after the app product; do not hard-code it.
    ipa = Dir[File.join(IPA_DIR, "*.ipa")].first
    UI.user_error!("flutter build ipa produced no .ipa in #{IPA_DIR}") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end
end
