PERF_TEST_EMAIL=admin@example.com
PERF_TEST_PASSWORD=yourpassword

# Required for teardown to auto-delete perf-probe-* users after each run.
# Local: supabase status → service_role key
# Remote: Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# GoTrue base URL — must match your API's SUPABASE_URL.
SUPABASE_URL=http://localhost:54321
