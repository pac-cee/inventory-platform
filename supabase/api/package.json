{
  "name": "inventory-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Shared Express API for the Inventory web + mobile apps. Issues its own JWT sessions and runs all queries against Neon PostgreSQL, enforcing authorization in the application layer.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "APP_ENV=test tsx watch src/index.ts",
    "dev:prod": "APP_ENV=production tsx watch src/index.ts",
    "build": "sh scripts/build.sh",
    "start": "node dist/index.js",
    "start:test": "APP_ENV=test node dist/index.js",
    "start:prod": "APP_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "APP_ENV=test NODE_ENV=test vitest run",
    "test:watch": "APP_ENV=test NODE_ENV=test vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "resend": "^6.17.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
