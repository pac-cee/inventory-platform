# Copy this file to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Database — Neon (or any) PostgreSQL connection string.
# Neon: Dashboard → your project → Connection Details → pooled connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign/verify the API's own HS256 access tokens.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional token lifetimes (seconds). Defaults: 1h access, 30d refresh.
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=2592000

# Port the API listens on (default 4000)
PORT=4000

# Comma-separated list of allowed CORS origins (the web app's URL, etc.).
# Use * to allow any origin (development only).
CORS_ORIGINS=http://localhost:3000

# MTN MoMo (disbursement). Leave blank to run the payment gateway in MOCK mode.
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_TARGET_ENV="sandbox"

# UrubutoPay (BK's payment-gateway product, used for BK-method payment
# requests via bulk disbursement). Leave blank to run BK requests in MOCK
# mode. Get the API key + wallet account id from BK/UrubutoPay support —
# there's no self-service signup for the wallet/disbursement APIs.
URUBUTOPAY_API_KEY=""
URUBUTOPAY_BASE_URL="https://staging.urubutopay.rw"  # /api is appended automatically
# Header carrying the key: Authorization (spec prose) or x-api-key (spec securityScheme) — spec contradicts itself
URUBUTOPAY_AUTH_HEADER="Authorization"
URUBUTOPAY_WALLET_ACCOUNT_ID=""
# Callback auth: UrubutoPay logs in to POST <api>/webhooks/urubutopay/auth with
# these, then sends the returned Bearer token on every callback. Pick a long
# random password and give both values + the URL to UrubutoPay at setup.
URUBUTOPAY_WEBHOOK_USER=""
URUBUTOPAY_WEBHOOK_PASSWORD=""

# Google Drive (EBM receipt uploads). OAuth as a real Google account, not a
# service account — service accounts have no Drive storage quota, and the
# Shared Drive workaround for that requires Google Workspace. The uploading
# account only needs contributor/Editor access to the target folder, not
# ownership — files just end up counting against ITS Drive quota, not the
# folder owner's. Get these three by creating a "Desktop app" OAuth client at
# https://console.cloud.google.com/apis/credentials, then running:
#   GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... node get-drive-refresh-token.mjs
#
# IMPORTANT: the OAuth consent screen must be "Published" (production status),
# not "Testing" — Google auto-expires refresh tokens issued under Testing
# status after 7 days regardless of use. Publishing (Cloud Console > OAuth
# consent screen > Publish App) is free/instant for this app's narrow
# `drive.file` scope and does not require Google's verification review.
#
# Single point of failure: whichever account authorized this token is the one
# uploads happen as. If that account loses folder access or the grant is
# revoked, uploads break until someone with folder access re-runs the script.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
# Folder ID to upload receipts into (from the folder's Drive URL). Falls back
# to a hardcoded default in src/lib/drive.ts if unset.
GOOGLE_DRIVE_EBM_FOLDER_ID=""

# ---------------------------------------------------------------------------
# `.env` holds the shared config above. PORT / CORS_ORIGINS / DATABASE_URL can
# be overridden per environment by `.env.test` / `.env.production`, selected via
# APP_ENV:
#     npm run start:prod   -> .env + .env.production
#     npm run start:test   -> .env + .env.test
#     npm start            -> .env only
# ---------------------------------------------------------------------------

# MTN MoMo — production switches (leave blank in dev: the sandbox and no callbacks).
#   MOMO_BASE_URL           https://proxy.momoapi.mtn.com for real money (default: the sandbox)
#   MOMO_CALLBACK_BASE_URL  public https origin MTN calls back to, e.g. https://api.example.com
#                           Its HOST must equal the "Provider callback host" registered for the
#                           API user in MTN's account portal. Blank = no callback requested; the
#                           2-minute reconciler settles payments instead.
#   MOMO_COUNTRY_CODE       prefix for local 0-numbers (default 250)
MOMO_BASE_URL=""
MOMO_CALLBACK_BASE_URL=""
